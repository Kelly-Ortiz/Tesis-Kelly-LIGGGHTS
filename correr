#!/usr/bin/env bash
#==============================================================================
# correr — Ejecutor de simulaciones LIGGGHTS con respaldo automático
#          y notificaciones de avance por WhatsApp
#==============================================================================
#
# DESCRIPCIÓN
#   Ejecuta una simulación LIGGGHTS del repositorio de la tesis. Opera sobre el
#   repositorio en el que se encuentra la usuaria en ese momento (detectado de
#   forma automática), por lo que respeta la rama activa: al cambiar de rama,
#   las carpetas de simulación disponibles cambian solas.
#
#   Detecta los recursos de la máquina, ajusta la descomposición del dominio y
#   escribe puntos de control que permiten reanudar tras una interrupción sin
#   introducir artefactos en la física del tornillo. Opcionalmente envía avisos
#   de avance por WhatsApp.
#
# UBICACIONES (solo dos conceptos)
#   1. El repositorio: la carpeta donde está clonado el repo (cualquier nombre
#      y ubicación). Es la fuente de los archivos de entrada; no se modifica.
#   2. La carpeta de trabajo: ~/liggghts-trabajo/<simulacion>/  — se crea sola y
#      contiene la copia de trabajo, los puntos de control y los resultados.
#      Vive fuera del repositorio para no interferir con el cambio de ramas.
#
# USO
#   correr <simulacion> [opciones]      (ejecutado dentro del repositorio)
#   correr --ayuda
#==============================================================================

set -uo pipefail

#------------------------------------------------------------------------------
# Parámetros de configuración del entorno
#------------------------------------------------------------------------------
readonly DIR_TRABAJO="${HOME}/liggghts-trabajo"
readonly GB_RESERVADOS_POR_PROCESO=5
readonly IMAGEN_V1="cesarsant2000/liggghts-motor"
readonly IMAGEN_V2="cesarsant2000/liggghts-motor-v2"
readonly PASOS_RESPALDO_POR_DEFECTO=1000000
readonly ARCHIVO_CONFIG_WHATSAPP="${HOME}/.liggghts_whatsapp.conf"
readonly URL_WHATSAPP="https://api.callmebot.com/whatsapp.php"
readonly SEGUNDOS_ENTRE_REVISIONES=60

# Variable global con la raíz del repositorio; se fija en main().
DIR_REPO=""

# Credenciales de WhatsApp (se cargan del archivo de configuración si existe).
WHATSAPP_PHONE=""
WHATSAPP_APIKEY=""
if [[ -f "${ARCHIVO_CONFIG_WHATSAPP}" ]]; then
    # shellcheck disable=SC1090
    source "${ARCHIVO_CONFIG_WHATSAPP}"
fi

#------------------------------------------------------------------------------
# detectar_repositorio
#   Devuelve la raíz del repositorio Git que contiene el directorio actual.
#   Si no se está dentro de un repositorio, devuelve una cadena vacía.
#------------------------------------------------------------------------------
detectar_repositorio() {
    git rev-parse --show-toplevel 2>/dev/null
}

#------------------------------------------------------------------------------
# rama_actual
#   Devuelve el nombre de la rama activa del repositorio.
#------------------------------------------------------------------------------
rama_actual() {
    git -C "${DIR_REPO}" rev-parse --abbrev-ref HEAD 2>/dev/null
}

#------------------------------------------------------------------------------
# mostrar_ayuda
#------------------------------------------------------------------------------
mostrar_ayuda() {
    cat <<'AYUDA'
==============================================================================
  correr — Ejecutor de simulaciones LIGGGHTS
==============================================================================

QUÉ HACE
  Corre una simulación del repositorio de la tesis. Trabaja sobre el repositorio
  donde usted se encuentre y respeta la rama activa: al cambiar de rama, las
  simulaciones disponibles cambian automaticamente. Guarda puntos de control
  para poder retomar y, de forma opcional, envia avisos por WhatsApp.

IMPORTANTE
  Ejecute el comando desde dentro de la carpeta del repositorio (en cualquier
  subcarpeta sirve). El programa detecta la raiz del repositorio por si mismo.

FORMA DE USO
  correr <simulacion> [opciones]

EJEMPLOS
  correr MASVEL2MENCOFAZURE
        Corre esa simulación con la configuración automática.
  correr MASVEL2MENCOFAZURE --nucleos 4
        Corre usando exactamente 4 procesos.
  correr MASVEL2MENCOFAZURE --version v1
        Usa el contenedor v1 en lugar del v2 (predeterminado).
  correr MASVEL2MENCOFAZURE --avisos 25
        Envía un aviso de WhatsApp cada 25% de avance.
  correr MASVEL2MENCOFAZURE --reiniciar
        Ignora cualquier punto de control y empieza desde cero.

OPCIONES
  -n, --nucleos N     Número de procesos (automático si se omite).
  -v, --version V     Versión del contenedor: v1 o v2. Predeterminado: v2.
  -a, --avisos P      Aviso de WhatsApp cada P por ciento (predeterminado: 10).
      --sin-whatsapp  Desactiva los avisos de WhatsApp para esta ejecución.
  -r, --reiniciar     Fuerza el inicio desde cero (descarta el respaldo).
  -l, --listar        Muestra las simulaciones de la rama actual y termina.
  -e, --estado        Muestra el avance de las simulaciones y termina.
  -t, --todas         Ejecuta en orden todas las simulaciones pendientes.
  -p, --probar-whatsapp  Envía un mensaje de prueba por WhatsApp y termina.
  -u, --actualizar    Reinstala el propio comando desde el repositorio actual.
  -h, --ayuda         Muestra esta ayuda y termina.

CÓMO TRABAJAR SIN PERDER LA SESIÓN
  Antes de una simulación larga, abra una sesión persistente:
      screen -S sim
  Para salir sin detenerla: Ctrl+A y luego D.  Para volver: screen -r sim

SI SE INTERRUMPE
  Vuelva a ejecutar el mismo comando: se reanuda desde el último punto de
  control automáticamente.

AVISOS POR WHATSAPP (activación única)
  1. Guarde en contactos el número que indique la pagina de CallMeBot.
  2. Envíele por WhatsApp:  I allow callmebot to send me messages
  3. Guarde el APIKEY recibido en  ~/.liggghts_whatsapp.conf  con:
        WHATSAPP_PHONE=+593XXXXXXXXX
        WHATSAPP_APIKEY=su_apikey
  4. Compruebe con:  correr --probar-whatsapp

DÓNDE QUEDAN LOS RESULTADOS
  ~/liggghts-trabajo/<simulacion>/   (post, massflow.csv, rt_*.txt, log_sim.txt)

==============================================================================
AYUDA
}

#------------------------------------------------------------------------------
# enviar_whatsapp
#   Envía un mensaje por WhatsApp (CallMeBot). Operación de mejor esfuerzo.
#------------------------------------------------------------------------------
enviar_whatsapp() {
    local mensaje="$1"
    [[ -z "${WHATSAPP_PHONE}" || -z "${WHATSAPP_APIKEY}" ]] && return 0
    curl -s -G "${URL_WHATSAPP}" \
        --max-time 15 \
        --data-urlencode "phone=${WHATSAPP_PHONE}" \
        --data-urlencode "text=${mensaje}" \
        --data-urlencode "apikey=${WHATSAPP_APIKEY}" \
        >/dev/null 2>&1 || true
}

#------------------------------------------------------------------------------
# detectar_motor
#------------------------------------------------------------------------------
detectar_motor() {
    if docker ps >/dev/null 2>&1; then
        echo "docker"
    elif command -v podman >/dev/null 2>&1; then
        echo "podman"
    else
        echo "ERROR: No hay un motor de contenedores disponible sin privilegios." >&2
        return 1
    fi
}

#------------------------------------------------------------------------------
# detectar_nucleos_fisicos
#------------------------------------------------------------------------------
detectar_nucleos_fisicos() {
    local nucleos
    nucleos=$(lscpu -p=Core,Socket 2>/dev/null | grep -v '^#' | sort -u | wc -l)
    if [[ -z "${nucleos}" || "${nucleos}" -lt 1 ]]; then
        nucleos=$(nproc)
    fi
    echo "${nucleos}"
}

#------------------------------------------------------------------------------
# calcular_procesos
#------------------------------------------------------------------------------
calcular_procesos() {
    local forzado="${1:-}"
    local fisicos ram_mb ram_gb tope procesos
    fisicos=$(detectar_nucleos_fisicos)
    ram_mb=$(free -m | awk '/^Mem:/{print $2}')
    ram_gb=$(( ram_mb / 1024 ))
    tope=$(( ram_gb / GB_RESERVADOS_POR_PROCESO ))
    [[ "${tope}" -lt 1 ]] && tope=1
    procesos="${fisicos}"
    [[ "${tope}" -lt "${procesos}" ]] && procesos="${tope}"
    [[ -n "${forzado}" ]] && procesos="${forzado}"
    echo "${procesos}"
}

#------------------------------------------------------------------------------
# ruta_simulacion
#   Localiza la carpeta de una simulación dentro del repositorio actual.
#------------------------------------------------------------------------------
ruta_simulacion() {
    find "${DIR_REPO}" -type d -name "$1" 2>/dev/null | head -1
}

#------------------------------------------------------------------------------
# listar_simulaciones
#------------------------------------------------------------------------------
listar_simulaciones() {
    echo "Repositorio: ${DIR_REPO}"
    echo "Rama activa: $(rama_actual)"
    echo "Simulaciones disponibles en esta rama:"
    local encontradas
    encontradas=$(find "${DIR_REPO}" -name 'in.*' -type f 2>/dev/null \
        | sed 's|.*/\([^/]*\)/in\..*|  - \1|' | sort -u)
    if [[ -n "${encontradas}" ]]; then
        echo "${encontradas}"
    else
        echo "  (ninguna en esta rama)"
    fi
}

#------------------------------------------------------------------------------
# mostrar_estado
#------------------------------------------------------------------------------
mostrar_estado() {
    echo "Estado de las simulaciones (carpeta de trabajo ${DIR_TRABAJO}):"
    if [[ ! -d "${DIR_TRABAJO}" ]]; then
        echo "  (todavía no se ha ejecutado ninguna)"
        return
    fi
    local dir nombre paso estado
    for dir in "${DIR_TRABAJO}"/*/; do
        [[ -d "${dir}" ]] || continue
        nombre=$(basename "${dir}")
        if [[ -f "${dir}/log_sim.txt" ]]; then
            paso=$(awk 'NF>0 && $1 ~ /^[0-9]+$/ {s=$1} END{print s}' "${dir}/log_sim.txt")
            [[ -z "${paso}" ]] && paso="(sin datos aún)"
        else
            paso="(sin iniciar)"
        fi
        estado="en progreso"
        [[ -f "${dir}/COMPLETADO" ]] && estado="COMPLETADA"
        printf "  - %-30s paso: %-12s estado: %s\n" "${nombre}" "${paso}" "${estado}"
    done
}

#------------------------------------------------------------------------------
# pasos_por_vuelta
#------------------------------------------------------------------------------
pasos_por_vuelta() {
    local archivo="$1" dt periodo pasos
    dt=$(grep -iE "variable[[:space:]]+dt[[:space:]]+equal" "${archivo}" | head -1 | awk '{print $NF}')
    periodo=$(grep -iE "variable[[:space:]]+screwPeriod[[:space:]]+equal" "${archivo}" | head -1 | awk '{print $NF}')
    if [[ -n "${dt}" && -n "${periodo}" ]]; then
        pasos=$(awk -v p="${periodo}" -v d="${dt}" 'BEGIN{printf "%d", p/d}')
    fi
    if [[ -z "${pasos:-}" || "${pasos}" -lt 1 ]]; then
        pasos="${PASOS_RESPALDO_POR_DEFECTO}"
    fi
    echo "${pasos}"
}

#------------------------------------------------------------------------------
# calcular_pasos_totales
#------------------------------------------------------------------------------
calcular_pasos_totales() {
    local archivo="$1" filltime dischargetime dt total
    filltime=$(grep -iE "variable[[:space:]]+filltime[[:space:]]+equal" "${archivo}" | head -1 | awk '{print $NF}')
    dischargetime=$(grep -iE "variable[[:space:]]+dischargetime[[:space:]]+equal" "${archivo}" | head -1 | awk '{print $NF}')
    dt=$(grep -iE "variable[[:space:]]+dt[[:space:]]+equal" "${archivo}" | head -1 | awk '{print $NF}')
    if [[ -n "${filltime}" && -n "${dischargetime}" && -n "${dt}" ]]; then
        total=$(awk -v a="${filltime}" -v b="${dischargetime}" -v d="${dt}" 'BEGIN{printf "%d",(a+b)/d}')
        echo "${total:-0}"
    else
        echo "0"
    fi
}

#------------------------------------------------------------------------------
# monitor_progreso
#------------------------------------------------------------------------------
monitor_progreso() {
    local log="$1" total="$2" nombre="$3" intervalo="$4"
    local ultimo_hito=0 paso pct
    [[ "${total}" -lt 1 ]] && return 0
    while true; do
        sleep "${SEGUNDOS_ENTRE_REVISIONES}"
        [[ -f "${log}" ]] || continue
        paso=$(awk 'NF>0 && $1 ~ /^[0-9]+$/ {s=$1} END{print s}' "${log}")
        [[ -z "${paso}" ]] && continue
        pct=$(( paso * 100 / total ))
        if [[ "${pct}" -ge $(( ultimo_hito + intervalo )) ]]; then
            ultimo_hito=$(( (pct / intervalo) * intervalo ))
            enviar_whatsapp "Simulacion *${nombre}*: ${pct}% completado (paso ${paso} de ${total})."
        fi
    done
}

#------------------------------------------------------------------------------
# generar_input_reanudacion
#------------------------------------------------------------------------------
generar_input_reanudacion() {
    local origen="$1" destino="$2" restart="$3" pasos="$4"
    awk -v ARCHIVO_RESTART="${restart}" -v PASOS="${pasos}" '
        BEGIN { continuacion = 0 }
        {
            linea = $0
            if (continuacion == 1) {
                print "# [reanudacion] " linea
                continuacion = (linea ~ /&[ \t]*$/) ? 1 : 0
                next
            }
            if (linea ~ /^[ \t]*create_box/) { print "read_restart " ARCHIVO_RESTART; next }
            if (linea ~ /particletemplate/ || linea ~ /particledistribution/ || \
                linea ~ /mesh\/surface\/planar/ || linea ~ /insert\/stream/) {
                print "# [reanudacion] " linea
                if (linea ~ /&[ \t]*$/) continuacion = 1
                next
            }
            if (linea ~ /^[ \t]*unfix[ \t]+ins[ \t]*$/) { print "# [reanudacion] " linea; next }
            if (linea ~ /^[ \t]*run[ \t]+\$\{fillsteps\}/) { print "# [reanudacion] " linea; next }
            if (linea ~ /^[ \t]*run[ \t]+\$\{dischargesteps\}/) {
                print "variable totalsteps equal ${fillsteps}+${dischargesteps}"
                print "restart " PASOS " restart.continuar.a restart.continuar.b"
                print "run ${totalsteps} upto"
                next
            }
            print linea
        }
    ' "${origen}" > "${destino}"
}

#------------------------------------------------------------------------------
# diagnosticar_error
#------------------------------------------------------------------------------
diagnosticar_error() {
    local log="$1" codigo="$2" cola=""
    [[ -f "${log}" ]] && cola=$(tail -n 40 "${log}")
    if [[ "${codigo}" -eq 137 ]] || echo "${cola}" | grep -qiE "signal 9|killed|out of memory|cannot allocate"; then
        echo "Falta de memoria (RAM). Sugerencia: reducir el numero de procesos con --nucleos."
        return
    fi
    local linea_error
    linea_error=$(echo "${cola}" | grep -iE "ERROR" | tail -n 1)
    if [[ -n "${linea_error}" ]]; then
        if echo "${linea_error}" | grep -qiE "lost atoms|particles? lost"; then
            echo "Se perdieron particulas (posible inestabilidad numerica o dt muy grande)."
        elif echo "${linea_error}" | grep -qiE "bond atoms missing|neighbor list overflow"; then
            echo "Desbordamiento de la lista de vecinos o particulas fuera del dominio."
        else
            echo "Error de LIGGGHTS: $(echo "${linea_error}" | cut -c1-120)"
        fi
        return
    fi
    [[ "${codigo}" -eq 130 ]] && { echo "Detenida manualmente (Ctrl+C)."; return; }
    echo "Causa no identificada (codigo ${codigo}). Revise log_sim.txt para mas detalle."
}

#------------------------------------------------------------------------------
# ejecutar_simulacion
#   Argumentos: nombre forzado version reiniciar(0|1) avisos_pct usar_whatsapp(0|1)
#------------------------------------------------------------------------------
ejecutar_simulacion() {
    local nombre="$1" forzado="$2" version="$3" reiniciar="$4" avisos="$5" usar_whatsapp="$6"
    local motor imagen ruta archivo entrada procesos
    local dir_run restart_a restart_b reciente pasos total monitor_pid

    motor=$(detectar_motor) || return 1
    if [[ "${version}" == "v1" ]]; then imagen="${IMAGEN_V1}"; else imagen="${IMAGEN_V2}"; fi

    ruta=$(ruta_simulacion "${nombre}")
    if [[ -z "${ruta}" ]]; then
        echo "ERROR: No existe la simulación '${nombre}' en la rama actual ($(rama_actual))." >&2
        echo "       Use 'correr --listar' para ver las disponibles." >&2
        return 1
    fi
    archivo=$(find "${ruta}" -name 'in.*' -type f | head -1)
    if [[ -z "${archivo}" ]]; then
        echo "ERROR: La carpeta '${nombre}' no contiene un archivo de entrada in.*" >&2
        return 1
    fi
    entrada=$(basename "${archivo}")

    procesos=$(calcular_procesos "${forzado}")
    pasos=$(pasos_por_vuelta "${archivo}")
    total=$(calcular_pasos_totales "${archivo}")

    dir_run="${DIR_TRABAJO}/${nombre}"
    restart_a="${dir_run}/restart.continuar.a"
    restart_b="${dir_run}/restart.continuar.b"

    reciente=""
    if [[ "${reiniciar}" -eq 0 ]]; then
        local candidato
        for candidato in "${restart_a}" "${restart_b}"; do
            [[ -s "${candidato}" ]] || continue
            if [[ -z "${reciente}" || "${candidato}" -nt "${reciente}" ]]; then
                reciente="${candidato}"
            fi
        done
    fi

    echo "=============================================================="
    echo "  Simulación   : ${nombre} (${entrada})"
    echo "  Repositorio  : ${DIR_REPO}  [rama: $(rama_actual)]"
    echo "  Motor/Imagen : ${motor} / ${imagen}"
    echo "  Procesos     : ${procesos}"
    echo "  Respaldo     : cada ${pasos} pasos (una vuelta del tornillo)"
    echo "  Pasos totales: ${total}"
    if [[ "${usar_whatsapp}" -eq 1 && -n "${WHATSAPP_PHONE}" ]]; then
        echo "  WhatsApp     : avisos cada ${avisos}%"
    else
        echo "  WhatsApp     : desactivado"
    fi

    if [[ -n "${reciente}" ]]; then
        echo "  Modo         : REANUDAR desde $(basename "${reciente}")"
        echo "=============================================================="
        generar_input_reanudacion "${archivo}" "${dir_run}/${entrada}" \
            "$(basename "${reciente}")" "${pasos}"
        sed -i "s/^processors.*/processors ${procesos} 1 1/" "${dir_run}/${entrada}"
        [[ -f "${dir_run}/massflow.csv" ]] && \
            cp "${dir_run}/massflow.csv" "${dir_run}/massflow.$(date +%s).csv"
    else
        echo "  Modo         : INICIO desde cero"
        echo "=============================================================="
        rm -rf "${dir_run}"
        mkdir -p "${dir_run}/post"
        cp -r "${ruta}"/. "${dir_run}/"
        sed -i "s/^processors.*/processors ${procesos} 1 1/" "${dir_run}/${entrada}"
        if grep -q 'run[[:space:]]*${dischargesteps}' "${dir_run}/${entrada}"; then
            sed -i "/run[[:space:]]*\${dischargesteps}/i restart ${pasos} restart.continuar.a restart.continuar.b" \
                "${dir_run}/${entrada}"
        fi
    fi

    echo "  Inicio: $(date '+%H:%M:%S %d-%m-%Y')"

    monitor_pid=0
    if [[ "${usar_whatsapp}" -eq 1 && -n "${WHATSAPP_PHONE}" && "${total}" -ge 1 ]]; then
        enviar_whatsapp "Simulacion *${nombre}* iniciada con ${procesos} procesos. Avisos cada ${avisos}%."
        monitor_progreso "${dir_run}/log_sim.txt" "${total}" "${nombre}" "${avisos}" &
        monitor_pid=$!
    fi

    "${motor}" run --rm \
        -v "${dir_run}":/simulaciones \
        "${imagen}" \
        mpirun -np "${procesos}" --allow-run-as-root --bind-to none --oversubscribe \
        lmp380 -in "/simulaciones/${entrada}" -log /simulaciones/log_sim.txt
    local resultado=$?

    if [[ "${monitor_pid}" -ne 0 ]]; then
        kill "${monitor_pid}" >/dev/null 2>&1 || true
        wait "${monitor_pid}" 2>/dev/null || true
    fi

    echo "  Fin: $(date '+%H:%M:%S %d-%m-%Y')"
    if [[ "${resultado}" -eq 0 ]]; then
        touch "${dir_run}/COMPLETADO"
        echo "  Estado: COMPLETADA. Resultados en ${dir_run}"
        [[ "${usar_whatsapp}" -eq 1 ]] && \
            enviar_whatsapp "Simulacion *${nombre}* COMPLETADA con exito. Resultados listos para descargar."
    else
        local diagnostico
        diagnostico=$(diagnosticar_error "${dir_run}/log_sim.txt" "${resultado}")
        if [[ -s "${restart_a}" || -s "${restart_b}" ]]; then
            echo "  Estado: detenida. Causa: ${diagnostico}"
            echo "          Hay un punto de control; para reanudar ejecute: correr ${nombre}"
            [[ "${usar_whatsapp}" -eq 1 ]] && \
                enviar_whatsapp "Simulacion *${nombre}* se detuvo. Causa: ${diagnostico} Hay respaldo: para retomar, vuelva a ejecutarla."
        else
            echo "  Estado: ERROR antes del primer respaldo. Causa: ${diagnostico}"
            echo "          Revise ${dir_run}/log_sim.txt"
            [[ "${usar_whatsapp}" -eq 1 ]] && \
                enviar_whatsapp "Simulacion *${nombre}* FALLO. Causa: ${diagnostico} No hay respaldo aun; revise la configuracion."
        fi
    fi
    return "${resultado}"
}

#------------------------------------------------------------------------------
# ejecutar_todas
#------------------------------------------------------------------------------
ejecutar_todas() {
    local forzado="$1" version="$2" avisos="$3" usar_whatsapp="$4"
    local nombres total indice nombre
    mapfile -t nombres < <(find "${DIR_REPO}" -name 'in.*' -type f -exec dirname {} \; \
        | sort -u | xargs -n1 basename)
    total=${#nombres[@]}
    indice=0
    for nombre in "${nombres[@]}"; do
        indice=$(( indice + 1 ))
        if [[ -f "${DIR_TRABAJO}/${nombre}/COMPLETADO" ]]; then
            echo ">> [${indice}/${total}] ${nombre}: ya completada, se omite."
            continue
        fi
        echo ""
        echo ">> [${indice}/${total}] Ejecutando ${nombre} ..."
        ejecutar_simulacion "${nombre}" "${forzado}" "${version}" 0 "${avisos}" "${usar_whatsapp}"
    done
    echo ""
    echo "Proceso finalizado: todas las simulaciones pendientes fueron atendidas."
}

#------------------------------------------------------------------------------
# probar_whatsapp
#------------------------------------------------------------------------------
probar_whatsapp() {
    if [[ -z "${WHATSAPP_PHONE}" || -z "${WHATSAPP_APIKEY}" ]]; then
        echo "WhatsApp no está configurado." >&2
        echo "Cree el archivo ${ARCHIVO_CONFIG_WHATSAPP} con WHATSAPP_PHONE y WHATSAPP_APIKEY." >&2
        return 1
    fi
    echo "Enviando mensaje de prueba a ${WHATSAPP_PHONE}..."
    enviar_whatsapp "Mensaje de prueba: la configuracion de avisos LIGGGHTS funciona correctamente."
    echo "Si no llega en un minuto, revise el número y el apikey en ${ARCHIVO_CONFIG_WHATSAPP}."
}

#------------------------------------------------------------------------------
# actualizar_comando
#   Reinstala este mismo comando en ~/bin a partir de la copia del repositorio
#   actual. Útil tras actualizar el repositorio o cambiar a una rama con una
#   versión más reciente de la herramienta.
#------------------------------------------------------------------------------
actualizar_comando() {
    local origen="${DIR_REPO}/correr"
    if [[ ! -f "${origen}" ]]; then
        echo "ERROR: No se encontró 'correr' en la raíz del repositorio." >&2
        return 1
    fi
    mkdir -p "${HOME}/bin"
    install -m 0755 "${origen}" "${HOME}/bin/correr"
    echo "Comando 'correr' actualizado en ~/bin desde ${DIR_REPO}."
}

#------------------------------------------------------------------------------
# main
#------------------------------------------------------------------------------
main() {
    local simulacion="" forzado="" version="v2"
    local reiniciar=0 accion="ejecutar" avisos=10 usar_whatsapp=1

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--ayuda|--help) accion="ayuda"; shift ;;
            -l|--listar)       accion="listar"; shift ;;
            -e|--estado)       accion="estado"; shift ;;
            -t|--todas)        accion="todas"; shift ;;
            -p|--probar-whatsapp) accion="probar"; shift ;;
            -u|--actualizar)   accion="actualizar"; shift ;;
            -r|--reiniciar)    reiniciar=1; shift ;;
            --sin-whatsapp)    usar_whatsapp=0; shift ;;
            -n|--nucleos)      forzado="${2:-}"; shift 2 ;;
            -v|--version)      version="${2:-v2}"; shift 2 ;;
            -a|--avisos)       avisos="${2:-10}"; shift 2 ;;
            -*)
                echo "ERROR: Opción no reconocida: $1" >&2
                echo "       Use 'correr --ayuda' para ver las opciones." >&2
                return 1 ;;
            *) simulacion="$1"; shift ;;
        esac
    done

    # La ayuda no requiere estar dentro del repositorio.
    if [[ "${accion}" == "ayuda" ]]; then mostrar_ayuda; return 0; fi

    # El resto de acciones requieren ubicar el repositorio actual.
    DIR_REPO=$(detectar_repositorio)
    if [[ -z "${DIR_REPO}" ]]; then
        echo "ERROR: No se está dentro de un repositorio Git." >&2
        echo "       Entre a la carpeta del repositorio de simulaciones y vuelva a intentar." >&2
        return 1
    fi

    if [[ -n "${forzado}" && ! "${forzado}" =~ ^[0-9]+$ ]]; then
        echo "ERROR: El número de núcleos debe ser un entero positivo." >&2
        return 1
    fi
    if [[ ! "${avisos}" =~ ^[0-9]+$ || "${avisos}" -lt 1 || "${avisos}" -gt 100 ]]; then
        echo "ERROR: El porcentaje de avisos debe ser un entero entre 1 y 100." >&2
        return 1
    fi
    if [[ "${version}" != "v1" && "${version}" != "v2" ]]; then
        echo "ERROR: La versión debe ser 'v1' o 'v2'." >&2
        return 1
    fi

    case "${accion}" in
        listar)     listar_simulaciones ;;
        estado)     mostrar_estado ;;
        probar)     probar_whatsapp ;;
        actualizar) actualizar_comando ;;
        todas)      ejecutar_todas "${forzado}" "${version}" "${avisos}" "${usar_whatsapp}" ;;
        ejecutar)
            if [[ -z "${simulacion}" ]]; then
                echo "ERROR: Debe indicar el nombre de una simulación. Ejemplo: correr MASVEL2MENCOFAZURE" >&2
                echo "       Use 'correr --ayuda' para más información." >&2
                return 1
            fi
            ejecutar_simulacion "${simulacion}" "${forzado}" "${version}" \
                "${reiniciar}" "${avisos}" "${usar_whatsapp}"
            ;;
    esac
}

main "$@"
